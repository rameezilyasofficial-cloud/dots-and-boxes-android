<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- WINDOW 1: MAIN LAUNCHER (CAMPAIGN & CUSTOM SETUP) -->
    <ScrollView
        android:id="@+id/configContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:gravity="center_horizontal">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOTS &amp; BOXES PRO"
                android:textColor="@color/accent_blue"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <!-- Player Rank, Stars & Coins Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#121824"
                android:padding="10dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRankBadge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌱 ROOKIE STRIKER"
                    android:textColor="#F8FAFC"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 0/90"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:id="@+id/tvTotalCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪙 100"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Mode Selector Tabs (30-Level Campaign vs Custom Free Play) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/btnTabCampaign"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🏆 30-LVL CAMPAIGN"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnTabCustom"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="⚔️ CUSTOM PLAY"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- SECTION A: 30-LEVEL CAMPAIGN MAP -->
            <LinearLayout
                android:id="@+id/campaignSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SELECT CAMPAIGN STAGE (TAP UNLOCKED LEVEL TO PLAY)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/campaignLevelsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- SECTION B: CUSTOM FREE PLAY CONFIG -->
            <LinearLayout
                android:id="@+id/customPlaySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvDeviceType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMARTPHONE DISPLAY OPTIMIZED"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GRID RATIO (UP TO 5x8)"
                    android:textColor="@color/text_light"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/gridOptionsLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NUMBER OF PLAYERS"
                    android:textColor="@color/text_light"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:id="@+id/playerCountTabsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ROSTER &amp; AI DIFFICULTY (TAP BADGE TO CYCLE)"
                    android:textColor="@color/text_light"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:id="@+id/rosterLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnStartMatch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="LAUNCH CUSTOM MATCH"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:backgroundTint="@color/accent_blue"
                    android:layout_marginTop="18dp" />
            </LinearLayout>

            <!-- GLOBAL SETTINGS CARD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AUDIO, HAPTICS &amp; SPEED IQ SETTINGS"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#121824"
                android:padding="12dp"
                android:layout_marginTop="6dp">

                <Switch
                    android:id="@+id/switchSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Polyphonic Synth Audio FX"
                    android:textColor="@color/text_light"
                    android:checked="true"
                    android:paddingVertical="4dp" />

                <Switch
                    android:id="@+id/switchVibration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HD Waveform Haptic Feedback"
                    android:textColor="@color/text_light"
                    android:checked="true"
                    android:paddingVertical="4dp" />

                <Switch
                    android:id="@+id/switchSpeedAnalytics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Speed IQ / Reaction Analytics"
                    android:textColor="@color/accent_blue"
                    android:checked="true"
                    android:paddingVertical="4dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- WINDOW 2: ARENA SCREEN -->
    <LinearLayout
        android:id="@+id/arenaContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top HUD -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="14dp"
            android:background="@color/bg_card">

            <ImageButton
                android:id="@+id/btnLeaveArena"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/text_light" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvArenaStageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEVEL 1 • FIRST CONTACT"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTurnIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Player 1's Turn"
                    android:textColor="@color/text_light"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnResetMatch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="@color/text_light" />
        </RelativeLayout>

        <!-- Live Scoreboard Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F1420"
            android:paddingVertical="8dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/arenaScoresLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp" />
        </HorizontalScrollView>

        <!-- Canvas Game Surface -->
        <com.fixtocode.dotsandboxes.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- WINDOW 3: VICTORY / STAGE RESULT OVERLAY -->
    <FrameLayout
        android:id="@+id/winnerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60A0D14"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:background="@drawable/bg_victory_card"
                android:orientation="vertical"
                android:padding="22dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvWinnerStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐⭐⭐"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/tvWinnerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STAGE CLEARED!"
                    android:textColor="#38BDF8"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvWinnerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+125 Coins Earned"
                    android:textColor="#F59E0B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <!-- Standings Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MATCH STANDINGS"
                    android:textColor="@color/text_light"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp" />

                <LinearLayout
                    android:id="@+id/winnerStatsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />

                <!-- Speed IQ & Reaction Time Analytics Section -->
                <TextView
                    android:id="@+id/tvAnalyticsHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ SPEED IQ &amp; REFLEX ANALYTICS"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp" />

                <LinearLayout
                    android:id="@+id/winnerAnalyticsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnOverlayPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="NEXT LEVEL ⏭"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:backgroundTint="@color/accent_blue"
                    android:layout_marginTop="18dp" />

                <Button
                    android:id="@+id/btnOverlaySettings"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="BACK TO MENU"
                    android:textStyle="bold"
                    android:textColor="@color/text_light"
                    android:backgroundTint="#1E293B"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>