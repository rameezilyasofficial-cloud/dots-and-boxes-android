<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- WINDOW 1: CONFIGURATION SCREEN -->
    <ScrollView
        android:id="@+id/configContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOTS &amp; BOXES"
                android:textColor="@color/accent_blue"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvDeviceType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETECTING DISPLAY..."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Grid Matrix Options -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRID SIZE (UP TO 5x7)"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="24dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/gridOptionsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Quick Player Count Selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NUMBER OF PLAYERS"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/playerCountTabsLayout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginTop="8dp" />

            <!-- Roster Configuration List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PLAYERS CONFIGURATION"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/rosterLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnStartMatch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="START GAME"
                android:textStyle="bold"
                android:textColor="#000000"
                android:backgroundTint="@color/accent_blue"
                android:layout_marginTop="28dp" />
        </LinearLayout>
    </ScrollView>

    <!-- WINDOW 2: ARENA SCREEN -->
    <LinearLayout
        android:id="@+id/arenaContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top HUD -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp"
            android:background="@color/bg_card">

            <ImageButton
                android:id="@+id/btnLeaveArena"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/text_light" />

            <TextView
                android:id="@+id/tvTurnIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Player 1's Turn"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnResetMatch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="@color/text_light" />
        </RelativeLayout>

        <!-- Scoreboard Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F1420"
            android:paddingVertical="8dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/arenaScoresLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp" />
        </HorizontalScrollView>

        <!-- Canvas -->
        <com.fixtocode.dotsandboxes.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</FrameLayout>