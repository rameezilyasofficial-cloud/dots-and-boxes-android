<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- WINDOW 1: CONFIGURATION SCREEN -->
    <ScrollView
        android:id="@+id/configContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOTS &amp; BOXES"
                android:textColor="@color/accent_blue"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvDeviceType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETECTING HARDWARE..."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Grid Matrix Options -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRID RATIO (UP TO 5x8)"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="22dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/gridOptionsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Quick Player Count Selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NUMBER OF PLAYERS"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="18dp" />

            <LinearLayout
                android:id="@+id/playerCountTabsLayout"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:layout_marginTop="8dp" />

            <!-- Roster Configuration List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ROSTER CONFIGURATION"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="18dp" />

            <LinearLayout
                android:id="@+id/rosterLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <!-- SETTINGS & ANALYTICS CARD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SETTINGS &amp; SPEED IQ ANALYTICS"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#121824"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <Switch
                    android:id="@+id/switchSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sound Effects (Audio FX)"
                    android:textColor="@color/text_light"
                    android:checked="true"
                    android:paddingVertical="4dp" />

                <Switch
                    android:id="@+id/switchVibration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vibration (Haptic Tap)"
                    android:textColor="@color/text_light"
                    android:checked="true"
                    android:paddingVertical="4dp" />

                <Switch
                    android:id="@+id/switchSpeedAnalytics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Speed IQ / Reaction Analytics"
                    android:textColor="@color/accent_blue"
                    android:checked="true"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStartMatch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="START GAME"
                android:textStyle="bold"
                android:textColor="#000000"
                android:backgroundTint="@color/accent_blue"
                android:layout_marginTop="24dp" />
        </LinearLayout>
    </ScrollView>

    <!-- WINDOW 2: ARENA SCREEN -->
    <LinearLayout
        android:id="@+id/arenaContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top HUD -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp"
            android:background="@color/bg_card">

            <ImageButton
                android:id="@+id/btnLeaveArena"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/text_light" />

            <TextView
                android:id="@+id/tvTurnIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Player 1's Turn"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnResetMatch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="@color/text_light" />
        </RelativeLayout>

        <!-- Live Scoreboard Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F1420"
            android:paddingVertical="8dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/arenaScoresLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp" />
        </HorizontalScrollView>

        <!-- Canvas Game Surface -->
        <com.fixtocode.dotsandboxes.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- WINDOW 3: VICTORY POPUP OVERLAY -->
    <FrameLayout
        android:id="@+id/winnerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60A0D14"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/bg_victory_card"
                android:orientation="vertical"
                android:padding="22dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/tvWinnerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAYER 1 WINS!"
                    android:textColor="#38BDF8"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvWinnerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dominated the grid"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <!-- Standings Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MATCH STANDINGS"
                    android:textColor="@color/text_light"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp" />

                <LinearLayout
                    android:id="@+id/winnerStatsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />

                <!-- Speed IQ & Reaction Time Analytics Section -->
                <TextView
                    android:id="@+id/tvAnalyticsHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ SPEED IQ &amp; REFLEX ANALYTICS"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp" />

                <LinearLayout
                    android:id="@+id/winnerAnalyticsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnOverlayPlayAgain"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="PLAY AGAIN"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:backgroundTint="@color/accent_blue"
                    android:layout_marginTop="18dp" />

                <Button
                    android:id="@+id/btnOverlaySettings"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="CHANGE SETTINGS"
                    android:textStyle="bold"
                    android:textColor="@color/text_light"
                    android:backgroundTint="#1E293B"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>